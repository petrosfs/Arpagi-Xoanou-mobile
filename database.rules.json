{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && (data.child('meta/host').val() === auth.uid || data.child('meta/createdAt').val() < now - 86400000)",
        ".validate": "$code.matches(/^[A-HJ-NP-Z2-9]{4}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid || (data.exists() && newData.child('host').val() === auth.uid && root.child('rooms').child($code).child('players').child(auth.uid).exists() && root.child('rooms').child($code).child('players').child(data.child('host').val()).child('online').val() !== true))",
          ".validate": "newData.hasChildren(['host', 'status', 'createdAt']) && newData.child('status').val().matches(/^(lobby|playing|ended)$/)"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (($uid === auth.uid && (data.exists() || root.child('rooms').child($code).child('meta/status').val() === 'lobby')) || root.child('rooms').child($code).child('meta/host').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['name', 'joinedAt', 'online']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16 && newData.child('online').isBoolean())"
          }
        },
        "signal": {
          "$to": {
            "$from": {
              ".write": "auth != null && $from === auth.uid"
            }
          }
        },
        "relay": {
          "$from": {
            ".write": "auth != null && $from === auth.uid"
          }
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/host').val() === auth.uid"
        }
      }
    }
  }
}
